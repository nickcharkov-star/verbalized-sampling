{
  "name": "still_motion",
  "description": "A teaser cut from campaign stills, the night-edit way: slow pushes into the photograph, hard cuts, one dissolve to the end card, and no grade at all — the lacquer and the gold stay the colour they are.",
  "bpm": 84,
  "subdivision": 2.0,
  "tempo_curve": [[0.0, 1.3], [0.3, 1.0], [0.7, 0.9], [1.0, 1.5]],
  "arc": [
    {"name": "hook",    "roles": ["product", "macro"], "weight": 1.3, "motion": "push_slow",  "transition": "cut",      "min_dur": 1.2, "max_dur": 2.6, "hold": true},
    {"name": "world",   "roles": ["macro", "product"],            "weight": 0.9, "motion": "drift_left", "transition": "cut",      "min_dur": 0.8, "max_dur": 2.0},
    {"name": "detail",  "roles": ["macro", "product"],            "weight": 0.9, "motion": "push",       "transition": "cut",      "min_dur": 0.8, "max_dur": 1.8},
    {"name": "reveal",  "roles": ["product", "macro"],            "weight": 1.3, "motion": "push_slow",  "transition": "cut",      "min_dur": 1.4, "max_dur": 3.0, "hold": true, "title": "product"},
    {"name": "resolve", "roles": ["product", "macro"],          "weight": 1.1, "motion": "pull",       "transition": "cut",      "min_dur": 1.0, "max_dur": 2.4},
    {"name": "endcard", "roles": ["logo", "product", "texture"],  "weight": 1.3, "motion": "static",     "transition": "dissolve", "min_dur": 1.6, "max_dur": 3.0, "hold": true, "title": "endcard"}
  ],
  "dissolve_budget": 1,
  "dissolve_frames": 14,
  "motion_amount": 0.05,
  "grade": {},
  "grain": 0,
  "vignette": 0,
  "typography": {
    "wordmark_font": ["Jost-500.ttf"],
    "tagline_font": ["BodoniModa-96-400i.ttf"],
    "wordmark_size": 0.034,
    "tagline_size": 0.052,
    "tracking": 14,
    "color": "white@0.95",
    "shadow": "black@0.30",
    "fade_frames": 10,
    "safe_bottom": 0.18,
    "safe_top": 0.12
  },
  "audio": {"bed": "warm_pad", "root_hz": 98.0, "swell_at": "reveal", "target_lufs": -15.0, "fade_in": 1.0, "fade_out": 1.8},
  "role_affinity": {"product": 1.15, "macro": 1.05, "texture": 0.85, "logo": 1.0, "talent": 0.7, "gesture": 0.7}
}
