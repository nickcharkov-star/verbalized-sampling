<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ece6dc">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &middot; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..600;1,6..96,400&family=Jost:wght@400;500&family=Pinyon+Script&display=swap">
  {{ 'domain-black.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'index' -%}
    <link rel="preload" as="image" href="{{ 'lineup-1280.webp' | asset_url }}"
          imagesrcset="{{ 'lineup-800.webp' | asset_url }} 800w, {{ 'lineup-1280.webp' | asset_url }} 1280w, {{ 'lineup-1920.webp' | asset_url }} 1920w"
          imagesizes="(min-width: 1600px) 1520px, 100vw" fetchpriority="high">
  {%- endif -%}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip" href="#main">Skip to content</a>

  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'domain-scripts' %}
</body>
</html>
