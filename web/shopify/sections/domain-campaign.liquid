{%- comment -%}
  The campaign photograph, shown whole and unaltered. No crop to a grid,
  no recolour, no retouch — the frame as it was taken, beside the words.
{%- endcomment -%}
{%- assign shot = section.settings.shot -%}

<section class="band campaign" id="section-{{ section.id }}">
  <div class="band-in campaign-grid">
    <figure class="campaign-plate">
      {%- if shot -%}
        {{ shot | image_url: width: 900 | image_tag:
             widths: '300, 500, 700, 900',
             sizes: '(min-width: 880px) 30vw, 80vw',
             alt: shot.alt | default: section.settings.caption,
             crossorigin: 'anonymous' }}
      {%- else -%}
        <span class="lot-empty" style="width:min(80vw,330px);aspect-ratio:9/16"></span>
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <figcaption>{{ section.settings.caption | escape }}</figcaption>
      {%- endif -%}
    </figure>
    <div class="campaign-side">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-fade>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="display" style="font-size:clamp(1.5rem,1rem + 2.3vw,2.9rem);margin-top:.6rem" data-fade>
        {{ section.settings.heading | escape }}
      </h2>
      {%- if section.settings.body != blank -%}
        <div class="lede" style="margin-top:1.1rem" data-fade>{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The campaign",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "image_picker", "id": "shot", "label": "Campaign photograph",
      "info": "Shown whole, at a size the file can carry. Nothing is cropped or recoloured." },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Sovereign · campaign frame · shown as shot" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shown as shot." },
    { "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>Not retouched here, not recoloured, not cropped to fit a grid. The frame as it was taken.</p>" }
  ],
  "presets": [{ "name": "The campaign" }]
}
{% endschema %}
