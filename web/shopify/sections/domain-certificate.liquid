{{ 'domain-black.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Jost:wght@200;300;400;500&family=Pinyon+Script&display=swap">

<section class="band cert" data-cert id="section-{{ section.id }}">
  <div class="band-in cert-stage">
    <canvas data-rosette id="rosette" aria-hidden="true"></canvas>

    <div class="cert-lock">
      {% if section.settings.eyebrow != blank %}
        <p class="cert-sub">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h1 class="display wordmark" aria-label="{{ section.settings.wordmark | escape }}">
        {%- assign parts = section.settings.wordmark | split: ' ' -%}
        {%- for part in parts -%}
          <span data-word>{{ part }}</span>{% unless forloop.last %} {% endunless %}
        {%- endfor -%}
      </h1>

      {% if section.settings.tagline != blank %}
        <p class="cert-say">{{ section.settings.tagline | escape }}</p>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="lede" style="max-width:46ch;text-align:center;margin-inline:auto">
          {{ section.settings.body }}
        </div>
      {% endif %}
    </div>

    <dl class="bearer band-in">
      <div>
        <dt>{{ section.settings.label_1 | escape }}</dt>
        <dd class="num">No. <span data-certno="{{ section.settings.issue_no }}">0001</span></dd>
      </div>
      <div><dt>{{ section.settings.label_2 | escape }}</dt><dd>{{ section.settings.value_2 | escape }}</dd></div>
      <div><dt>{{ section.settings.label_3 | escape }}</dt><dd class="num">{{ section.settings.value_3 | escape }}</dd></div>
      <div><dt>{{ section.settings.label_4 | escape }}</dt><dd>{{ section.settings.value_4 | escape }}</dd></div>
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Certificate hero",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "header", "content": "Lockup" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Maison Domain · Bearer Instrument" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Domain Black",
      "info": "Each word animates in separately on load." },
    { "type": "text", "id": "tagline", "label": "Tagline (script face)", "default": "it's yours" },
    { "type": "richtext", "id": "body", "label": "Standfirst",
      "default": "<p>Five flacons, struck once. Each is issued to bearer and recorded in the register below.</p>" },

    { "type": "header", "content": "Bearer strip" },
    { "type": "text", "id": "label_1", "label": "Column 1 label", "default": "Issue" },
    { "type": "number", "id": "issue_no", "label": "Issue number", "default": 1247,
      "info": "Counts up on load, like a struck serial." },
    { "type": "text", "id": "label_2", "label": "Column 2 label", "default": "Instrument" },
    { "type": "text", "id": "value_2", "label": "Column 2 value", "default": "Extrait · 50 ml" },
    { "type": "text", "id": "label_3", "label": "Column 3 label", "default": "Struck" },
    { "type": "text", "id": "value_3", "label": "Column 3 value", "default": "MMXXVI" },
    { "type": "text", "id": "label_4", "label": "Column 4 label", "default": "Payable to" },
    { "type": "text", "id": "value_4", "label": "Column 4 value", "default": "Bearer" }
  ],
  "presets": [{ "name": "Certificate hero" }]
}
{% endschema %}
