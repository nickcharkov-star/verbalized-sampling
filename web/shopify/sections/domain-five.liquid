{%- comment -%}
  Five Worlds. The merchant's own product photography, held inside an
  engraved plate — used as-is, nothing cropped or recoloured. Choosing a
  card recolours the 3D flacon above it.
{%- endcomment -%}

{%- assign coll = collections[section.settings.collection] -%}

<section class="band worlds" id="section-{{ section.id }}">
  <div class="band-in">
    <div class="worlds-head">
      <h2 class="display" style="font-size:clamp(1.5rem,1rem + 2.2vw,2.8rem)" data-fade>
        {{ section.settings.heading | escape }}
      </h2>
      {%- if section.settings.note != blank -%}
        <p class="eyebrow" data-fade>{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
    <hr class="rule">

    <div class="rail" data-rail role="list" aria-label="{{ section.settings.heading | escape }}">
      {%- if coll and coll.products.size > 0 -%}
        {%- assign numerals = 'I,II,III,IV,V,VI,VII,VIII,IX,X' | split: ',' -%}
        {%- for product in coll.products limit: section.settings.count -%}
          {%- assign alt = product.featured_image.alt | default: product.title -%}
          {%- assign swatch = product.metafields.domain.swatch | default: '#5b3a25' -%}
          <article class="world" data-world data-i="{{ forloop.index0 }}"
                   role="listitem" aria-current="{{ forloop.first }}"
                   style="--w:{{ swatch }}">
            <a href="{{ product.url }}" class="world-plate" aria-label="{{ product.title | escape }}">
              <span class="world-num">{{ numerals[forloop.index0] }}</span>
              <canvas data-plate aria-hidden="true"></canvas>
              {%- comment -%}
                The merchant's own photograph, used as-is. With no photograph
                the plate is the composition's own colour — never a drawing of
                a bottle that was not photographed.
              {%- endcomment -%}
              <span class="world-field" aria-hidden="true"></span>
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 900 | image_tag:
                     class: 'world-art', loading: 'lazy',
                     widths: '240, 360, 540, 720, 900',
                     sizes: '(min-width: 900px) 20vw, 60vw', alt: alt }}
              {%- endif -%}
            </a>
            <div class="world-meta">
              <span class="world-name">{{ product.title | escape }}</span>
              {%- if product.metafields.domain.theme != blank -%}
                <span class="world-theme">{{ product.metafields.domain.theme }}</span>
              {%- elsif product.type != blank -%}
                <span class="world-theme">{{ product.type }}</span>
              {%- endif -%}
              {%- if product.metafields.domain.accord != blank -%}
                <span class="world-notes">
                  {%- assign notes = product.metafields.domain.accord | split: ',' -%}
                  {%- for n in notes -%}
                    <span>{{ n | strip }}</span>{% unless forloop.last %}<span>&middot;</span>{% endunless %}
                  {%- endfor -%}
                </span>
              {%- endif -%}
              {%- if product.metafields.domain.line != blank -%}
                <span class="world-line">{{ product.metafields.domain.line }}</span>
              {%- endif -%}
              {%- if product.metafields.domain.world != blank -%}
                <span class="world-world">{{ product.metafields.domain.world }}</span>
              {%- endif -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              <span class="world-price">
                {%- if v.title != blank and v.title != 'Default Title' -%}{{ v.title }} &middot; {% endif -%}
                {{ product.price | money }}
              </span>
            </div>
          </article>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%}
          No collection chosen. Show the shape of the section with the
          house's own renders, so the merchant can see what they are
          configuring rather than an empty band that looks broken.
        {%- endcomment -%}
        {%- assign stand = 'kingdom,sovereign,celestial,crown,empire' | split: ',' -%}
        {%- assign names = 'Kingdom,Sovereign,Celestial,Crown,Empire' | split: ',' -%}
        {%- assign numerals = 'I,II,III,IV,V' | split: ',' -%}
        {%- for h in stand -%}
          <article class="world" data-world data-i="{{ forloop.index0 }}" role="listitem"
                   aria-current="{{ forloop.index0 == 1 }}">
            <div class="world-plate">
              <span class="world-num">{{ numerals[forloop.index0] }}</span>
              <canvas data-plate aria-hidden="true"></canvas>
              <span class="world-field" aria-hidden="true"></span>
            </div>
            <div class="world-meta">
              <span class="world-name">{{ names[forloop.index0] }}</span>
              <span class="world-theme">Choose a collection</span>
              <span class="world-price">20&thinsp;ml &middot; $40</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Five Worlds",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five Worlds" },
    { "type": "text", "id": "note", "label": "Note", "default": "Domain I – V · One House" },
    { "type": "collection", "id": "collection", "label": "Collection",
      "info": "Product images are used as-is, held inside an engraved plate." },
    { "type": "range", "id": "count", "label": "Products shown", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "header", "content": "Metafields" },
    { "type": "paragraph", "content": "Optional product metafields in the “domain” namespace fill the card: domain.theme (a short disposition, e.g. Quiet Authority), domain.accord (a comma-separated note list), domain.line (one line of copy), domain.world (the room it evokes), domain.swatch (a colour, used for the card’s plate and hover edge). Without them the card falls back to product type and price." }
  ],
  "presets": [{ "name": "Five Worlds" }]
}
{% endschema %}
