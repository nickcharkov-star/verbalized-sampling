{%- comment -%}
  The flacon, in three dimensions. Each detail is a theme block, and each
  block carries the move it wants the object to make — so a merchant can
  add, remove or reorder details and the object still answers.
{%- endcomment -%}

<section class="band object" id="section-{{ section.id }}">
  <div class="band-in object-grid">
    <div class="stage" data-stage>
      <canvas data-flacon
              data-domain="{{ section.settings.domain }}"
              aria-label="{{ section.settings.aria | escape }}"></canvas>
      <div class="stage-fallback">
        <p>{{ section.settings.fallback }}</p>
      </div>
    </div>

    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-fade>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="display" style="font-size:clamp(1.6rem,1.05rem + 2.4vw,2.9rem);margin-top:.6rem" data-fade>
        {{ section.settings.heading | escape }}
      </h2>

      <div class="spec">
        {%- for block in section.blocks -%}
          <div class="spec-row" data-spec role="button" tabindex="0" aria-current="false"
               data-spin="{{ block.settings.spin }}"
               data-open="{{ block.settings.open }}"
               data-tilt="{{ block.settings.tilt }}"
               data-level="{{ block.settings.level }}"
               {{ block.shopify_attributes }}>
            <span class="spec-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="spec-t">{{ block.settings.title | escape }}
              {%- if block.settings.body != blank -%}
                <span class="spec-d">{{ block.settings.body | escape }}</span>
              {%- endif -%}
            </span>
          </div>
        {%- else -%}
          <div class="spec-row" aria-current="false">
            <span class="spec-n">01</span>
            <span class="spec-t">Add a detail
              <span class="spec-d">Each detail block turns the flacon to show what it names.</span></span>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.hint != blank -%}
        <p class="hint"><span></span>{{ section.settings.hint | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Flacon · 3D",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Flacon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six decisions, held in the hand." },
    { "type": "range", "id": "domain", "label": "Starting colourway", "min": 0, "max": 4, "step": 1, "default": 1,
      "info": "0 Kingdom · 1 Sovereign · 2 Celestial · 3 Crown · 4 Empire" },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Drag to turn · scroll to open" },
    { "type": "text", "id": "aria", "label": "Screen-reader label", "default": "The flacon, in three dimensions. Drag to turn it." },
    { "type": "textarea", "id": "fallback", "label": "Fallback text",
      "default": "The flacon turns in three dimensions where WebGL is available. Everything else on this page reads the same without it.",
      "info": "Shown instead of the object on a browser without WebGL." }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The stone" },
        { "type": "text", "id": "body", "label": "Body", "default": "Each cap is a polished stone, so no two sit quite the same way." },
        { "type": "header", "content": "What the flacon does when this is chosen" },
        { "type": "range", "id": "spin", "label": "Turn", "min": 0, "max": 6.2, "step": 0.1, "default": 0,
          "info": "In radians. 0 is face on, 1.6 is side on, 3.1 is the back." },
        { "type": "range", "id": "open", "label": "Lift the stone", "min": 0, "max": 1, "step": 0.05, "default": 0 },
        { "type": "range", "id": "tilt", "label": "Tip", "min": -0.3, "max": 0.3, "step": 0.02, "default": 0 },
        { "type": "range", "id": "level", "label": "Fill", "min": 0, "max": 1, "step": 0.05, "default": 0.45 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "The Flacon · 3D",
    "blocks": [
      { "type": "detail", "settings": { "title": "The stone", "body": "Each cap is a polished stone, so no two sit quite the same way.", "spin": 0, "open": 1, "tilt": -0.1, "level": 0.45 } },
      { "type": "detail", "settings": { "title": "The knurled collar", "body": "Fluting cut into the gold, not printed on it. It flashes as the bottle turns.", "spin": 0.1, "open": 0.85, "tilt": -0.22, "level": 0.45 } },
      { "type": "detail", "settings": { "title": "The monogram", "body": "Raised, bevelled, struck through with the house diagonal.", "spin": 0, "open": 0, "tilt": 0, "level": 0.45 } },
      { "type": "detail", "settings": { "title": "The squircle", "body": "Not a cylinder and not a box — a superellipse, so it sits square and reads soft.", "spin": 1.6, "open": 0, "tilt": 0.06, "level": 0.45 } },
      { "type": "detail", "settings": { "title": "The lacquer", "body": "Satin under a clearcoat. The shine is on top of the colour, never in it.", "spin": 0.7, "open": 0, "tilt": -0.05, "level": 0.45 } },
      { "type": "detail", "settings": { "title": "The pour", "body": "Lift the stone and the extrait rocks in the neck, and keeps rocking after you stop.", "spin": 0.25, "open": 1, "tilt": 0.26, "level": 0.8 } }
    ]
  }]
}
{% endschema %}
