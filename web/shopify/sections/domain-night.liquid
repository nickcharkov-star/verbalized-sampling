{%- comment -%}
  Generated from web/index.html by scripts/shopify/sync-from-site.py —
  edit the site and sync rather than editing this file.
{%- endcomment -%}
<section class="night" id="night" data-page="18" data-night>
  <div class="wrap">
    <p class="runhead"><span>Domain Black</span><span>After Hours</span><span>p. 18</span></p>
    <div class="night-head">
      <h2 class="h-sec" data-ink>After <em>Hours</em></h2>
      <p class="dek">Served cold. The glass is misted where the ingredients are; run a hand across it and the mist comes back the way breath does.</p>
    </div>
    <div class="night-glass">
      <div class="pane" data-glass data-cursor="Wipe">
        <img src="{{ 'empire-1080.webp' | asset_url }}" srcset="{{ 'empire-720.webp' | asset_url }} 720w, {{ 'empire-1080.webp' | asset_url }} 1080w"
             sizes="(min-width: 860px) 45vw, 92vw" width="1080" height="1350" loading="lazy" decoding="async"
             alt="Empire behind cold glass: an orange flacon with an orange stone cap and gold monogram, between peaches, blood orange and ice.">
        <canvas data-glass-canvas aria-hidden="true"></canvas>
      </div>
      <div class="pane-notes">
        <p class="kicker">Nº V &mdash; Empire &mdash; Magnetic Arrival</p>
        <p class="pane-title">Peach, blood orange and rum, over ice.</p>
        <p class="pane-help"><span class="mouse">Pass the pointer over the glass to wipe it.</span><span class="touch">Drag across the glass to wipe it.</span></p>
        <a class="btn btn-light" href="{% if section.settings.product != blank %}{{ section.settings.product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-magnetic>Shop Empire <i aria-hidden="true">&rarr;</i></a>
      </div>
    </div>
    <div class="night-edit">
      <figure><span class="plate" data-develop data-parallax><img src="{{ 'night-kingdom-540.webp' | asset_url }}" srcset="{{ 'night-kingdom-540.webp' | asset_url }} 540w, {{ 'night-kingdom-1080.webp' | asset_url }} 1080w" sizes="(min-width: 860px) 30vw, 46vw" width="1080" height="1350" loading="lazy" decoding="async" alt="Kingdom set small and exact in a field of black."></span><figcaption><b>Nº I</b><span>Kingdom, the object</span></figcaption></figure>
      <figure><span class="plate" data-develop data-parallax><img src="{{ 'night-monogram-540.webp' | asset_url }}" srcset="{{ 'night-monogram-540.webp' | asset_url }} 540w, {{ 'night-monogram-1080.webp' | asset_url }} 1080w" sizes="(min-width: 860px) 30vw, 46vw" width="1080" height="1350" loading="lazy" decoding="async" alt="A band of the gold monogram across a black page, with the line It's Yours."></span><figcaption><b>S094</b><span>The monogram</span></figcaption></figure>
      <figure><span class="plate" data-develop data-parallax><img src="{{ 'night-sovereign-540.webp' | asset_url }}" srcset="{{ 'night-sovereign-540.webp' | asset_url }} 540w, {{ 'night-sovereign-1080.webp' | asset_url }} 1080w" sizes="(min-width: 860px) 30vw, 46vw" width="1080" height="1350" loading="lazy" decoding="async" alt="Sovereign set small and exact in a field of black."></span><figcaption><b>Nº II</b><span>Sovereign, the object</span></figcaption></figure>
    </div>
  </div>
</section>

{% schema %}
{"name": "After hours", "tag": "div", "class": "domain-section", "settings": [{"type": "product", "id": "product", "label": "Product behind the glass", "info": "The button goes to it. Leave empty to send people to the catalogue."}]}
{% endschema %}
