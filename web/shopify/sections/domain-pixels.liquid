{%- comment -%}
  The photograph, taken apart.

  One particle per pixel of the merchant's own campaign photograph —
  simulated on the GPU, scrubbed by scroll position through this tall
  section. Five movements: the frame, diffusion, a luminance relief, the
  pixels sorted into the house colours, and all of them reassembled into
  the flacon.

  The section is tall and its stage is sticky, so scroll position *is*
  the movement index. That works with no animation library at all.
{%- endcomment -%}

{%- assign shot = section.settings.shot -%}
{%- if shot -%}{%- assign shot_url = shot | image_url: width: 900 -%}{%- endif -%}

<section class="pixels" id="section-{{ section.id }}"
         data-pixels
         data-shot="{{ shot_url }}"
         data-shape="{{ section.settings.shape_image | default: nil | image_url: width: 900 | default: '' }}"
         data-shape-asset="{{ 'flacon-' | append: section.settings.shape | append: '.png' | asset_url }}"
         style="min-height:{{ section.settings.length }}vh"
         aria-labelledby="pixelsTitle-{{ section.id }}">
  <div class="pixels-sticky">
    <div class="pixels-stage">
      {%- if shot -%}
        <canvas data-pixelfield aria-label="{{ section.settings.aria | escape }}"></canvas>
      {%- endif -%}
      <div class="pixels-fallback">
        <p>
          {%- if shot -%}{{ section.settings.fallback }}
          {%- else -%}Choose a campaign photograph in the theme editor.{%- endif -%}
        </p>
      </div>
      <div class="pixels-cap">
        <p class="eyebrow" id="pixelsTitle-{{ section.id }}">
          <span data-mv-num>I</span> &middot; <span data-mv-name>Frame</span>
        </p>
        <b data-mv-note>Every pixel at home</b>
        {%- if section.settings.hint != blank -%}
          <small>{{ section.settings.hint | escape }}</small>
        {%- endif -%}
      </div>
      <p class="pixels-count">
        <span data-pf-count>&mdash;</span><br>{{ section.settings.counter | escape }}
      </p>
    </div>
    <ol class="moves" data-moves></ol>
  </div>
</section>

{% schema %}
{
  "name": "The photograph · pixels",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "image_picker", "id": "shot", "label": "Campaign photograph",
      "info": "Every pixel becomes a particle. A portrait crop reads best. Very large files make a lot of particles — around a megapixel is plenty." },
    { "type": "select", "id": "shape", "label": "Reassembles into",
      "options": [
        { "value": "kingdom",   "label": "Kingdom" },
        { "value": "sovereign", "label": "Sovereign" },
        { "value": "celestial", "label": "Celestial" },
        { "value": "crown",     "label": "Crown" },
        { "value": "empire",    "label": "Empire" }
      ],
      "default": "sovereign",
      "info": "Which flacon the final movement assembles. Uses the rendered bottles shipped with the theme." },
    { "type": "image_picker", "id": "shape_image", "label": "Or your own silhouette",
      "info": "A PNG with transparency. Its opaque area is the shape the pixels reassemble into — overrides the choice above." },
    { "type": "range", "id": "length", "label": "Scroll length", "min": 200, "max": 600, "step": 20, "unit": "vh", "default": 420,
      "info": "How much scrolling the five movements take." },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Drag to push them aside · press to pull them back" },
    { "type": "text", "id": "counter", "label": "Counter caption", "default": "one particle per pixel" },
    { "type": "text", "id": "aria", "label": "Screen-reader label",
      "default": "The campaign photograph rebuilt from its own pixels. Drag to push them aside; press to pull them back." },
    { "type": "textarea", "id": "fallback", "label": "Fallback text",
      "default": "This movement needs WebGL 2 with float render targets. Everything else on this page reads the same without it.",
      "info": "Shown instead of the field on a browser that cannot run it." }
  ],
  "presets": [{ "name": "The photograph · pixels" }]
}
{% endschema %}
