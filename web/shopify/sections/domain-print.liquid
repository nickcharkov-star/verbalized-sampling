<div class="print-intro wrap">
  <p class="runhead"><span>Domain Black</span><span>The Print</span><span>p. 22</span></p>
  <div class="print-intro-grid">
    <h2 class="h-sec" data-ink>The <em>Print</em></h2>
    <p class="dek">Every picture in a magazine is made of dots. This is the lineup on the cover, one dot for every pixel. Scroll to take it apart; drag to push the dots aside, press to pull them home.</p>
  </div>
</div>
<section class="print wrap" id="print" data-page="22" data-pixels aria-label="The Print">
  <div class="print-sticky">
    <div class="print-stage">
      <canvas data-pixelfield aria-label="The lineup photograph drawn as halftone dots, one per pixel. Drag to push the dots aside; press to pull them back."></canvas>
      <div class="print-fallback">
        <figure class="plate">
          <img src="{{ 'lineup-800.webp' | asset_url }}" width="800" height="450" loading="lazy" decoding="async" alt="The five Domain Black flacons on stone in late sun.">
        </figure>
        <p data-fallback-why>This page draws the print with WebGL 2. This browser does not offer it, so here is the photograph it is made from.</p>
      </div>
      <div class="print-cap">
        <p><span data-mv-num>I</span> &middot; <span data-mv-name>The Plate</span><b data-mv-note>Every dot where the photograph put it</b></p>
        <p class="print-count"><span data-pf-count>&mdash;</span></p>
      </div>
      <p class="print-help">Drag to push the dots aside &middot; press to pull them home</p>
    </div>
    <ol class="moves" data-moves aria-label="Movements"></ol>
  </div>
</section>

