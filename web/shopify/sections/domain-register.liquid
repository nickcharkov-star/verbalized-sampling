{{ 'domain-black.css' | asset_url | stylesheet_tag }}

{%- assign coll = collections[section.settings.collection] -%}

<section class="band register" id="section-{{ section.id }}">
  <div class="band-in">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow" data-rise>{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2 class="display" style="font-size:clamp(1.6rem,1.05rem + 2.4vw,3rem);margin-top:.6rem" data-rise>
      {{ section.settings.heading | escape }}
    </h2>
    {% if section.settings.body != blank %}
      <div class="lede" style="margin-top:1.1rem" data-rise>{{ section.settings.body }}</div>
    {% endif %}

    <div class="reg-wrap">
      <table class="reg-table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_1 | escape }}</th>
            <th scope="col">{{ section.settings.col_2 | escape }}</th>
            <th scope="col">{{ section.settings.col_3 | escape }}</th>
            <th scope="col">{{ section.settings.col_4 | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- if coll and coll.products.size > 0 -%}
            {%- for product in coll.products limit: section.settings.count -%}
              {%- assign remaining = 0 -%}
              {%- for v in product.variants -%}
                {%- assign remaining = remaining | plus: v.inventory_quantity -%}
              {%- endfor -%}
              {%- comment -%}
                Runs are not all the same size. A per-product metafield wins over
                the section-wide default; plus: 0 coerces the text metafield to a
                number so the comparison below behaves.
              {%- endcomment -%}
              {%- assign run = product.metafields.domain.run | default: section.settings.run_size | plus: 0 -%}
              <tr>
                <td>
                  {%- if product.metafields.domain.swatch != blank -%}
                    <span class="swatch" style="background:{{ product.metafields.domain.swatch }}"></span>
                  {%- endif -%}
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </td>
                <td>
                  {%- if product.metafields.domain.accord != blank -%}
                    {{ product.metafields.domain.accord }}
                  {%- else -%}
                    {{ product.type | default: '—' }}
                  {%- endif -%}
                </td>
                <td class="num">
                  {%- if product.metafields.domain.vintage != blank -%}
                    {{ product.metafields.domain.vintage }}
                  {%- else -%}
                    {{ product.published_at | date: '%Y' }}
                  {%- endif -%}
                </td>
                {%- if product.available -%}
                  <td class="num">{{ remaining }}{% if run > 0 %} of {{ run }}{% endif %}</td>
                {%- else -%}
                  <td class="num" style="color:var(--oxblood)">{{ section.settings.sold_label | escape }}</td>
                {%- endif -%}
              </tr>
            {%- endfor -%}
          {%- else -%}
            <tr>
              <td colspan="4" style="color:var(--paper-dim)">
                Choose a collection in the theme editor to fill the register.
              </td>
            </tr>
          {%- endif -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Register",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Register" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every flacon is written down." },
    { "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>A share register, kept the old way. Lot, vintage, the accord it was struck on, and how many remain of the run.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Rows", "min": 3, "max": 20, "step": 1, "default": 5 },
    { "type": "number", "id": "run_size", "label": "Run size", "default": 120,
      "info": "Shown as “12 of 120”. Set to 0 to show the remaining count alone." },
    { "type": "text", "id": "sold_label", "label": "Sold-out label", "default": "Closed" },

    { "type": "header", "content": "Column headings" },
    { "type": "text", "id": "col_1", "label": "Column 1", "default": "Lot" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Accord" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Vintage" },
    { "type": "text", "id": "col_4", "label": "Column 4", "default": "Of run" },

    { "type": "header", "content": "Metafields" },
    { "type": "paragraph", "content": "Optional product metafields in the “domain” namespace fill these columns: domain.accord (single line text), domain.vintage (single line text), domain.swatch (a colour), domain.run (a number, overriding the run size above for that one lot). Without them the section falls back to product type, publish year and the run size above." }
  ],
  "presets": [{ "name": "The Register" }]
}
{% endschema %}
