{%- comment -%}
  A sloshing rule. A meniscus drawn across the page, pushed by how fast
  the visitor is scrolling: it overshoots and settles, because liquid
  does. Drop one between sections wherever the page needs a breath.
{%- endcomment -%}
<div class="band" style="padding-inline:0">
  <canvas class="liquid" data-liquid aria-hidden="true"
          style="height:{{ section.settings.height }}px;opacity:{{ section.settings.strength | divided_by: 100.0 }}"></canvas>
</div>

{% schema %}
{
  "name": "Sloshing rule",
  "tag": "section",
  "class": "domain-section",
  "settings": [
    { "type": "range", "id": "height", "label": "Height", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "strength", "label": "Strength", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 90 },
    { "type": "paragraph", "content": "The wave answers scroll speed. It holds still for visitors who ask for reduced motion." }
  ],
  "presets": [{ "name": "Sloshing rule" }]
}
{% endschema %}
