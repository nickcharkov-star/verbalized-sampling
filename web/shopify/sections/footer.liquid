<footer class="foot wrap">
  <span>{{ section.settings.left | escape }}</span>
  <nav aria-label="Footer">
    {%- for link in section.settings.menu.links -%}
      <a class="u" href="{{ link.url }}">{{ link.title | escape }}</a>
    {%- endfor -%}
  </nav>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "left", "label": "Left", "default": "Domain Black · Presence, not trend" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ]
}
{% endschema %}
