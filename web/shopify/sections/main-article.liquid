<section class="band thesis" id="section-{{ section.id }}">
  <article class="band-in" style="max-width:68ch">
    <p class="eyebrow" data-rise>{{ article.published_at | date: '%e %B %Y' }}</p>
    <h1 class="display" style="font-size:clamp(1.7rem,1.1rem + 2.4vw,3rem)" data-rise>{{ article.title | escape }}</h1>
    <hr class="rule">
    <div class="lede" data-rise>{{ article.content }}</div>
  </article>
</section>

{% schema %}
{ "name": "Article", "tag": "section", "class": "domain-section", "settings": [] }
{% endschema %}
