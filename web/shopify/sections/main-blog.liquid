<section class="band thesis" id="section-{{ section.id }}">
  <div class="band-in" style="max-width:72ch">
    <h1 class="display" style="font-size:clamp(1.7rem,1.1rem + 2.4vw,3rem)" data-rise>{{ blog.title | escape }}</h1>
    <hr class="rule">
    {%- for article in blog.articles -%}
      <article data-rise style="padding-block:1.6rem;border-bottom:1px solid var(--line-soft)">
        <p class="eyebrow">{{ article.published_at | date: '%e %B %Y' }}</p>
        <h2 class="display" style="font-size:1.4rem;margin:.4rem 0"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
        <p class="lede" style="margin:0">{{ article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
      </article>
    {%- else -%}
      <p class="lede">Nothing written yet.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "section", "class": "domain-section", "settings": [] }
{% endschema %}
