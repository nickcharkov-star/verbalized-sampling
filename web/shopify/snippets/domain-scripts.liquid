{%- comment -%}
  Motion libraries and theme behaviour.

  Include once per page, just before </body>:
      {% render 'domain-scripts' %}

  There is no 3D library any more: the pixel field is written directly
  against WebGL 2 and is 35 KB, where three.js was 671 KB for about five
  percent of its surface. GSAP and Lenis stay optional at runtime — with a
  blocked CDN the page still renders and reads, because every reveal
  animates *from* its resting state.

  To self-host them (recommended for production): upload gsap.min.js,
  ScrollTrigger.min.js and lenis.min.js to Assets and swap the three
  <script src> values for {{ 'gsap.min.js' | asset_url }} and so on.
{%- endcomment -%}

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js" defer></script>

<script type="module" src="{{ 'domain-black.js' | asset_url }}"></script>
