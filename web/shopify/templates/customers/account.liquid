<section class="band register">
  <div class="band-in">
    <h1 class="display" style="font-size:2rem">{{ 'customer.account.title' | t }}</h1>
    <hr class="rule">
    <div class="reg-wrap">
      <table class="reg-table">
        <thead><tr>
          <th scope="col">{{ 'customer.orders.order_number' | t }}</th>
          <th scope="col">{{ 'customer.orders.date' | t }}</th>
          <th scope="col">{{ 'customer.orders.total' | t }}</th>
        </tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%e %B %Y' }}</td>
              <td class="num">{{ order.total_price | money }}</td>
            </tr>
          {%- else -%}
            <tr><td colspan="3" style="color:var(--paper-dim)">{{ 'customer.orders.none' | t }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <p style="margin-top:1.4rem;display:flex;gap:1.4rem">
      <a class="eyebrow" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a>
      <a class="eyebrow" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </p>
  </div>
</section>
