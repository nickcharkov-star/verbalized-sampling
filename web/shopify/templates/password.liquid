<section class="band seal-sec">
  <div class="band-in" style="display:grid;place-items:center;gap:1.2rem;text-align:center">
    <h1 class="display" style="font-size:clamp(1.8rem,1.2rem + 2.6vw,3.2rem)">{{ shop.name | escape }}</h1>
    <p class="script" style="font-size:2rem;color:var(--gold);margin:0">it's yours</p>
    {%- form 'storefront_password', class: 'notify' -%}
      <input type="password" name="password" placeholder="Password" aria-label="Password" required>
      <button type="submit">Enter</button>
      {%- if form.errors -%}<p class="said" role="alert">{{ form.errors.messages.form }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
